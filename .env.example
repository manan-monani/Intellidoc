# ============================================================
# IntelliDoc Environment Configuration
# Copy this to .env and fill in your values
# ============================================================

# ---- Application ----
APP_NAME=IntelliDoc
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production

# ---- Database (PostgreSQL) ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=intellidoc
DB_USER=intellidoc_user
DB_PASSWORD=intellidoc_pass
DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# ---- AWS ----
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=ap-south-1
S3_BUCKET_NAME=intellidoc-documents
# For local development with LocalStack (docker-compose up -d):
#   set AWS_ENDPOINT_URL=http://localhost:4566
# For production AWS: leave this line commented out or remove it entirely
AWS_ENDPOINT_URL=http://localhost:4566

# ---- ML Models ----
# Set to "local" for CPU inference, "sagemaker" for AWS SageMaker
ML_INFERENCE_MODE=local
HUGGINGFACE_CACHE_DIR=./ml/models_cache

# ---- RAG Pipeline ----
FAISS_INDEX_PATH=./rag/faiss_index
EMBEDDING_MODEL=all-MiniLM-L6-v2
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# ---- JWT Auth ----
JWT_SECRET_KEY=your-jwt-secret-change-this
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- File Upload ----
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,tiff,docx
