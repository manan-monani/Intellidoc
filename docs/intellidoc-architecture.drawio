        <!-- ============ CONNECTIONS ============ -->

        <!-- Users → CloudFront -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#232F3E;strokeWidth=2;fontColor=#232F3E;fontSize=10;" edge="1" source="users" target="cloudfront" parent="1">
